{
  "name": "cloudflare-helpdesk",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "worker": "wrangler dev",
    "deploy": "node scripts/check-deploy.mjs && npm run build && wrangler deploy",
    "test": "vitest run",
    "test:integration": "python3 tests/run-integration.py"
  },
  "dependencies": {
    "@mantine/core": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "@tabler/icons-react": "^3.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
